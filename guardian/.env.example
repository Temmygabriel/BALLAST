# ── Copy to .env and fill in. Only needed for LIVE mode.
#    Offline ("sim") mode needs no env at all — try `npm run sim` first.

# --- Chain ---
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/XXXX
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/XXXX
CHAIN_ID=11155111                     # 11155111 Sepolia | 1 mainnet

# --- Aave v3 (verify per chain via Aave address book) ---
# Verified on Sepolia (2026-09): Pool 0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951.
# DEBT_ASSET MUST be the reserve Aave actually lists — on Aave v3 Sepolia the listed
# USDC is 0x94a9d9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8, NOT Circle's faucet USDC.
AAVE_POOL=0x0000000000000000000000000000000000000000
DEBT_ASSET=0x0000000000000000000000000000000000000000
DEBT_ASSET_DECIMALS=6
PROTECTED_WALLET=0x0000000000000000000000000000000000000000

# --- Risk policy ---
POLL_MS=12000
WARN_HF=1.15
ACT_HF=1.05
TARGET_HF=1.30
MAX_REPAY_UNITS=1000                  # hard cap the guard enforces (debt-asset units)
DEBT_ASSET_NAME=USDC                  # optional display label for the debt asset on the screen

# --- KeeperHub (live) ---
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_KEY=kh_...
# (writes use your account's Turnkey wallet integration — no per-call walletId)

# --- Cloud-live on Vercel (deploy these in the Vercel dashboard, NOT in code) ---
# To make the DEPLOYED app (https://your-app.vercel.app) show your REAL Aave position
# instead of the sim, set the same chain vars above as Vercel Environment Variables:
#   RPC_URL · CHAIN_ID · AAVE_POOL · DEBT_ASSET · DEBT_ASSET_DECIMALS · PROTECTED_WALLET
# (WARN_HF/ACT_HF/TARGET_HF are optional). Vercel env vars are encrypted; the repo never
# carries a secret. No dashboard change is needed for the sim demo — that stays the default.
#
# POST /rescue (real-money KeeperHub rescue from the URL) additionally needs, on Vercel:
#   BALLAST_LIVE_KEY        # operator key sent as the x-ballast-key header. Make one with
#                           # `openssl rand -hex 24` (or a password manager). NEVER commit it.
#   KEEPERHUB_MCP_URL       # same as above
#   KEEPERHUB_API_KEY       # same as above
# Without the key + KeeperHub creds the money path is refused (503) — the live read alone
# needs only the chain vars.

# --- DeepSeek (optional proposer; offline falls back to a deterministic planner) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
