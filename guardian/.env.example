# ── Copy to .env and fill in. Only needed for LIVE mode.
#    Offline ("sim") mode needs no env at all — try `npm run sim` first.

# --- Chain ---
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/XXXX
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/XXXX
CHAIN_ID=11155111                     # 11155111 Sepolia | 1 mainnet

# --- Aave v3 (verify per chain via Aave address book) ---
# Verified on Sepolia (2026-09): Pool 0x6Ae43d3271ff6888e7Fc43Fd7321a503ff738951.
# DEBT_ASSET MUST be the reserve Aave actually lists — on Aave v3 Sepolia the listed
# USDC is 0x94a9d9AC8a22534E3FaCa9F4e7F2E2cf85d5E4C8, NOT Circle's faucet USDC.
AAVE_POOL=0x0000000000000000000000000000000000000000
DEBT_ASSET=0x0000000000000000000000000000000000000000
DEBT_ASSET_DECIMALS=6
PROTECTED_WALLET=0x0000000000000000000000000000000000000000

# --- Risk policy ---
POLL_MS=12000
WARN_HF=1.15
ACT_HF=1.05
TARGET_HF=1.30
MAX_REPAY_UNITS=1000                  # hard cap the guard enforces (debt-asset units)

# --- KeeperHub (live) ---
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
KEEPERHUB_API_KEY=kh_...
# (writes use your account's Turnkey wallet integration — no per-call walletId)

# --- DeepSeek (optional proposer; offline falls back to a deterministic planner) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
